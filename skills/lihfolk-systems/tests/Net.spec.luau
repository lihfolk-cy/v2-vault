--!nonstrict
-- LihFolk Systems spec: Net. TestEZ-style; run with tests/Runner or TestEZ.
-- Pure logic only: no DataStores, no purchases. Written for Studio, NOT yet run.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LihFolk")

local Net = require(Shared.Net)
local T = Net.T

return function()
	describe("Net validators", function()
		it("integer rejects NaN, infinity, fractions and out of range", function()
			local v = T.integer(1, 10)
			expect(v(5)).to.equal(true)
			expect(v(0 / 0)).to.equal(false)
			expect(v(math.huge)).to.equal(false)
			expect(v(1.5)).to.equal(false)
			expect(v(11)).to.equal(false)
			expect(v("5")).to.equal(false)
		end)
		it("string caps bytes and requires valid UTF-8", function()
			local v = T.string(5)
			expect(v("abc")).to.equal(true)
			expect(v("abcdef")).to.equal(false)
			expect(v("\255\254")).to.equal(false)
			expect(v(5)).to.equal(false)
			expect(T.string(10, "^%a+$")("ab1")).to.equal(false)
		end)
		it("key only accepts real config keys", function()
			local v = T.key({ Sword = true })
			expect(v("Sword")).to.equal(true)
			expect(v("sword")).to.equal(false)
			expect(v("__index")).to.equal(false)
			expect(v(1)).to.equal(false)
		end)
		it("guid accepts GenerateGUID(false) output only", function()
			local guid = game:GetService("HttpService"):GenerateGUID(false)
			expect(T.guid(guid)).to.equal(true)
			expect(T.guid("{" .. guid .. "}")).to.equal(false)
			expect(T.guid(string.rep("x", 36))).to.equal(false)
		end)
		it("array rejects holes, extra length and bad items", function()
			local v = T.array(T.integer(0, 9), 3)
			expect(v({ 1, 2, 3 })).to.equal(true)
			expect(v({ 1, 2, 3, 4 })).to.equal(false)
			expect(v({ [1] = 1, [3] = 3 })).to.equal(false)
			expect(v({ 1, "x" })).to.equal(false)
			expect(v({ a = 1 })).to.equal(false)
		end)
		it("vector3 rejects NaN and huge magnitudes", function()
			local v = T.vector3(100)
			expect(v(Vector3.new(1, 2, 3))).to.equal(true)
			expect(v(Vector3.new(0 / 0, 0, 0))).to.equal(false)
			expect(v(Vector3.new(1000, 0, 0))).to.equal(false)
		end)
		it("checkArgs rejects extra and missing arguments", function()
			local validators = { T.integer(1, 3), T.optional(T.boolean) }
			expect((Net.checkArgs(validators, 2))).to.equal(true)
			expect((Net.checkArgs(validators, 2, true))).to.equal(true)
			expect((Net.checkArgs(validators, 2, true, "extra"))).to.equal(false)
			expect((Net.checkArgs(validators))).to.equal(false)
			expect((Net.checkArgs(validators, 2, "yes"))).to.equal(false)
		end)
	end)
end
